{
  "name": "penny",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web-legacy dev",
    "build": "tsc -b && pnpm --filter web-legacy build",
    "lint": "eslint packages/*/src apps/*/src",
    "lint:fix": "eslint packages/*/src apps/*/src --fix",
    "format": "prettier --write packages/*/src apps/*/src",
    "format:check": "prettier --check packages/*/src apps/*/src",
    "type-check": "tsc -b",
    "test": "pnpm --filter @penny/core test && pnpm --filter web-legacy test && pnpm test:workers",
    "test:workers": "vitest run",
    "test:watch": "pnpm --filter @penny/core test:watch",
    "test:coverage": "pnpm --filter @penny/core test:coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/*/src/**/*.{ts,tsx}": [
      "prettier --check",
      "eslint --max-warnings 0"
    ],
    "apps/*/src/**/*.{ts,tsx}": [
      "prettier --check",
      "eslint --max-warnings 0"
    ],
    "packages/*/src/**/*.{css,json,md}": [
      "prettier --check"
    ],
    "apps/*/src/**/*.{css,json,md}": [
      "prettier --check"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.8"
  }
}
