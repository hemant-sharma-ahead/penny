# Production build defaults — COMMITTED, non-secret only.
# VITE_* vars are baked into the client bundle at `npm run build` (web + the Android/iOS wrap).
# Vite loads this file in production mode (`npm run build`). Never put secrets here — the bundle is public.

# Route external finance APIs (market/NAV/vehicle) through the deployed Penny API Proxy Worker
# (Phase 1.5 Track A). Non-secret public URL. Override locally in .env.local (e.g. http://localhost:8787).
VITE_API_PROXY=https://penny-api-proxy.hesh.workers.dev
