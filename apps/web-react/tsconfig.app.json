{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strict mode */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,

    /* Path aliases */
    // Track 0 shortcut: @/core/* and @/lib/* (and the 5 hooks that moved) resolve straight into
    // packages/core/src via relative path mapping, so hundreds of `@/core/...`/`@/lib/...` import
    // statements across the app didn't need editing. Everything else still resolves locally. This raw
    // cross-package path mapping is a Track 0-only convenience — Track 1 introduces real package
    // resolution (`@penny/core`) once apps/mobile (Metro) needs to consume the same package.
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/core/*": ["../../packages/core/src/core/*"],
      "@/lib/*": ["../../packages/core/src/lib/*"],
      "@/hooks/useDataRefresh": ["../../packages/core/src/hooks/useDataRefresh"],
      "@/hooks/usePassphraseStrength": ["../../packages/core/src/hooks/usePassphraseStrength"],
      "@/hooks/useProfile": ["../../packages/core/src/hooks/useProfile"],
      "@/hooks/useRepository": ["../../packages/core/src/hooks/useRepository"],
      "@/hooks/useTxnRefresh": ["../../packages/core/src/hooks/useTxnRefresh"],
      "@/*": ["./src/*"]
    }
  },
  // packages/core/src is included (not just path-mapped) so cross-package generic inference
  // (e.g. EncryptedRepository<T>) resolves fully instead of degrading to `any` at the boundary.
  "include": ["src", "../../packages/core/src"]
}
