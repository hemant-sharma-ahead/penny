# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android/*
# Exception: the debug keystore is committed deliberately (2026-08-16) so its SHA-1 fingerprint stays
# stable across machines/rebuilds — Google Sign-In (Drive backup) is registered against this exact
# fingerprint in Google Cloud Console, and a clean `expo prebuild` regenerating a fresh, unregistered
# keystore would silently break sign-in with no obvious "keystore changed" error. This is the DEBUG
# keystore only (never signs anything meant for real distribution) — a release keystore must never be
# committed the same way.
!/android/app/
/android/app/*
!/android/app/debug.keystore
