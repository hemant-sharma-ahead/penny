{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "ES2020",
    // ES2020 alone has no type declaration for the 2-arg `Error(message, { cause })` constructor
    // (added to TS's lib in ES2022) — a real, already-supported-at-runtime feature (Node 16.9+, Hermes,
    // V8) this codebase already relies on for the `preserve-caught-error` ESLint rule's fix shape
    // (`throw new Error(msg, { cause: err })`). `lib` can safely be newer than `target` (it only adds
    // available global type declarations, doesn't change emitted syntax) — added just the one relevant
    // lib file rather than bumping to a full "ES2022" to keep this change narrow.
    "lib": ["ES2020", "ES2022.Error", "DOM", "DOM.Iterable"],
    "module": "esnext",
    // A handful of core files (entitlement.ts, net/apiBase.ts, sync/providers/googleDriveProvider.ts)
    // read `import.meta.env.VITE_*` directly — a Vite-ism that won't exist under Metro/RN. This is a
    // known seam flagged for Track 1/5 (needs a small platform-agnostic env-access abstraction);
    // kept as-is here (types only) to preserve today's behavior without building that abstraction early.
    "types": ["vite/client"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,

    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
