# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment
.env
.env.local
.env.*.local

# Cloudflare Workers (workers/*) — local dev state + local secrets. Never commit.
.wrangler/
.dev.vars
.dev.vars.*

# TypeScript incremental build cache
*.tsbuildinfo

# PWA generated files
dev-dist/
sw.js
workbox-*.js

# Generated by scripts/build-icon-index.mjs (gen:icons / predev / prebuild)
public/tablerIconIndex.json

.claude/worktrees/

# Capacitor native projects — generated from the web build (dist/) by
# `npx cap add <platform>`. Treated as build output (like dist/): regenerate
# locally, don't commit. The source of truth is capacitor.config.ts + deps.
# NOTE: native customisations (icons, splash, AndroidManifest, signing) would
# NOT be tracked while these are ignored — revisit if/when we customise them.
/android/
/ios/
